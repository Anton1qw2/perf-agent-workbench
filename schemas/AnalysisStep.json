{
  "$defs": {
    "AnalysisContext": {
      "additionalProperties": false,
      "properties": {
        "revision": {
          "default": 0,
          "maximum": 8,
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "result_id": {
          "default": "",
          "maxLength": 4096,
          "title": "Result Id",
          "type": "string"
        },
        "repository": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repository"
        },
        "branch": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Branch"
        }
      },
      "title": "AnalysisContext",
      "type": "object"
    },
    "AnalysisContextUpdate": {
      "additionalProperties": false,
      "properties": {
        "update_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Update Id",
          "type": "string"
        },
        "reply_to": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Reply To",
          "type": "string"
        },
        "previous": {
          "$ref": "#/$defs/AnalysisContext"
        },
        "current": {
          "$ref": "#/$defs/AnalysisContext"
        },
        "mode": {
          "default": "replace",
          "enum": [
            "replace",
            "compare"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "update_id",
        "reply_to",
        "previous",
        "current"
      ],
      "title": "AnalysisContextUpdate",
      "type": "object"
    },
    "AnalysisRequest": {
      "additionalProperties": false,
      "properties": {
        "context_revision": {
          "default": 0,
          "maximum": 8,
          "minimum": 0,
          "title": "Context Revision",
          "type": "integer"
        },
        "context_feedback": {
          "default": "",
          "maxLength": 2000,
          "title": "Context Feedback",
          "type": "string"
        },
        "result_id": {
          "default": "",
          "maxLength": 4096,
          "title": "Result Id",
          "type": "string"
        },
        "goal": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Goal",
          "type": "string"
        },
        "repository": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repository"
        },
        "branch": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Branch"
        },
        "metrics": {
          "items": {
            "type": "string"
          },
          "maxItems": 6,
          "title": "Metrics",
          "type": "array"
        },
        "include_asm": {
          "default": false,
          "title": "Include Asm",
          "type": "boolean"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceRequest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "goal"
      ],
      "title": "AnalysisRequest",
      "type": "object"
    },
    "ChatReport": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "markdown",
          "default": "markdown",
          "title": "Format",
          "type": "string"
        },
        "content": {
          "maxLength": 16000,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "content"
      ],
      "title": "ChatReport",
      "type": "object"
    },
    "ContextUpdateProposal": {
      "additionalProperties": false,
      "properties": {
        "expected_revision": {
          "maximum": 7,
          "minimum": 0,
          "title": "Expected Revision",
          "type": "integer"
        },
        "values": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "maxProperties": 3,
          "minProperties": 1,
          "propertyNames": {
            "enum": [
              "result_id",
              "repository",
              "branch"
            ]
          },
          "title": "Values",
          "type": "object"
        },
        "mode": {
          "default": "replace",
          "enum": [
            "replace",
            "compare"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "expected_revision",
        "values"
      ],
      "title": "ContextUpdateProposal",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "context": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnalysisContext"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "server": {
          "default": "profiler",
          "enum": [
            "profiler",
            "git"
          ],
          "title": "Server",
          "type": "string"
        },
        "operation": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Operation",
          "type": "string"
        },
        "arguments": {
          "additionalProperties": true,
          "title": "Arguments",
          "type": "object"
        },
        "response": {
          "title": "Response"
        },
        "retrieved_at": {
          "title": "Retrieved At",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "id",
        "operation",
        "arguments",
        "response",
        "retrieved_at",
        "sha256"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "EvidenceSelection": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "pointer": {
          "default": "",
          "maxLength": 2048,
          "title": "Pointer",
          "type": "string"
        }
      },
      "required": [
        "evidence_id"
      ],
      "title": "EvidenceSelection",
      "type": "object"
    },
    "HotspotFinding": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "hotspot": {
          "$ref": "#/$defs/HotspotSpec"
        },
        "status": {
          "enum": [
            "completed",
            "insufficient_data",
            "budget_exhausted"
          ],
          "title": "Status",
          "type": "string"
        },
        "interpretation": {
          "$ref": "#/$defs/Interpretation"
        },
        "delivered_evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Delivered Evidence Ids",
          "type": "array"
        },
        "knowledge_sources": {
          "items": {
            "$ref": "#/$defs/KnowledgeReference"
          },
          "title": "Knowledge Sources",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "id",
        "hotspot",
        "status"
      ],
      "title": "HotspotFinding",
      "type": "object"
    },
    "HotspotSpec": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "selections": {
          "items": {
            "$ref": "#/$defs/EvidenceSelection"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Selections",
          "type": "array"
        }
      },
      "required": [
        "label",
        "selections"
      ],
      "title": "HotspotSpec",
      "type": "object"
    },
    "Interpretation": {
      "additionalProperties": false,
      "properties": {
        "observations": {
          "items": {
            "$ref": "#/$defs/Observation"
          },
          "title": "Observations",
          "type": "array"
        },
        "hypotheses": {
          "items": {
            "$ref": "#/$defs/Observation"
          },
          "title": "Hypotheses",
          "type": "array"
        },
        "recommendations": {
          "items": {
            "type": "string"
          },
          "title": "Recommendations",
          "type": "array"
        }
      },
      "title": "Interpretation",
      "type": "object"
    },
    "KnowledgeReference": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "KnowledgeReference",
      "type": "object"
    },
    "Observation": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "text",
        "evidence_ids"
      ],
      "title": "Observation",
      "type": "object"
    },
    "ProfileAnalysis": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "completed",
            "needs_input",
            "insufficient_data"
          ],
          "title": "Status",
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/AnalysisRequest"
        },
        "demo": {
          "default": false,
          "title": "Demo",
          "type": "boolean"
        },
        "observations": {
          "items": {
            "$ref": "#/$defs/Observation"
          },
          "title": "Observations",
          "type": "array"
        },
        "hypotheses": {
          "items": {
            "$ref": "#/$defs/Observation"
          },
          "title": "Hypotheses",
          "type": "array"
        },
        "recommendations": {
          "items": {
            "type": "string"
          },
          "title": "Recommendations",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "open_questions": {
          "items": {
            "type": "string"
          },
          "title": "Open Questions",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "documentation": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Documentation"
        },
        "source_context": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceContext"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "delivered_evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Delivered Evidence Ids",
          "type": "array"
        },
        "clarification_field": {
          "default": "metrics",
          "enum": [
            "metrics",
            "source",
            "analysis_input"
          ],
          "title": "Clarification Field",
          "type": "string"
        },
        "tool_catalog": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Tool Catalog",
          "type": "array"
        },
        "git_tool_catalog": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Git Tool Catalog",
          "type": "array"
        },
        "analyzer": {
          "default": "legacy",
          "title": "Analyzer",
          "type": "string"
        },
        "chat_report": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChatReport"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "context_updates": {
          "items": {
            "$ref": "#/$defs/AnalysisContextUpdate"
          },
          "maxItems": 8,
          "title": "Context Updates",
          "type": "array"
        },
        "source_history": {
          "items": {
            "$ref": "#/$defs/SourceContext"
          },
          "maxItems": 8,
          "title": "Source History",
          "type": "array"
        },
        "hotspot_findings": {
          "items": {
            "$ref": "#/$defs/HotspotFinding"
          },
          "maxItems": 8,
          "title": "Hotspot Findings",
          "type": "array"
        },
        "knowledge_sources": {
          "items": {
            "$ref": "#/$defs/KnowledgeReference"
          },
          "maxItems": 128,
          "title": "Knowledge Sources",
          "type": "array"
        }
      },
      "required": [
        "status",
        "request"
      ],
      "title": "ProfileAnalysis",
      "type": "object"
    },
    "SourceContext": {
      "additionalProperties": false,
      "properties": {
        "snapshot": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceSnapshot"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/SourceEvidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/SourceLocation"
          },
          "title": "Candidates",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "needs_selection": {
          "default": false,
          "title": "Needs Selection",
          "type": "boolean"
        },
        "required_delivery": {
          "default": "not_required",
          "enum": [
            "not_required",
            "pending",
            "delivered",
            "interpretation_disabled"
          ],
          "title": "Required Delivery",
          "type": "string"
        }
      },
      "title": "SourceContext",
      "type": "object"
    },
    "SourceEvidence": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "repository": {
          "title": "Repository",
          "type": "string"
        },
        "commit": {
          "title": "Commit",
          "type": "string"
        },
        "blob": {
          "title": "Blob",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "start_line": {
          "title": "Start Line",
          "type": "integer"
        },
        "end_line": {
          "title": "End Line",
          "type": "integer"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "resolution": {
          "enum": [
            "provided_location",
            "model_location",
            "text_candidate"
          ],
          "title": "Resolution",
          "type": "string"
        },
        "origin": {
          "default": "user_selection",
          "enum": [
            "user_selection",
            "model_selection"
          ],
          "title": "Origin",
          "type": "string"
        }
      },
      "required": [
        "id",
        "repository",
        "commit",
        "blob",
        "path",
        "start_line",
        "end_line",
        "text",
        "sha256",
        "resolution"
      ],
      "title": "SourceEvidence",
      "type": "object"
    },
    "SourceLocation": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "start_line": {
          "default": 1,
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        },
        "end_line": {
          "default": 80,
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        }
      },
      "required": [
        "path"
      ],
      "title": "SourceLocation",
      "type": "object"
    },
    "SourceRequest": {
      "additionalProperties": false,
      "properties": {
        "policy": {
          "default": "optional",
          "enum": [
            "off",
            "optional",
            "required"
          ],
          "title": "Policy",
          "type": "string"
        },
        "commit": {
          "anyOf": [
            {
              "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit"
        },
        "scope_repository": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope Repository"
        },
        "scope_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope Ref"
        },
        "locations": {
          "items": {
            "$ref": "#/$defs/SourceLocation"
          },
          "maxItems": 5,
          "title": "Locations",
          "type": "array"
        },
        "symbols": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "title": "Symbols",
          "type": "array"
        },
        "repository": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Repository",
          "type": "string"
        },
        "ref": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Ref",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "ref"
      ],
      "title": "SourceRequest",
      "type": "object"
    },
    "SourceSnapshot": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "resolved",
            "unavailable",
            "disabled"
          ],
          "title": "Status",
          "type": "string"
        },
        "repository": {
          "title": "Repository",
          "type": "string"
        },
        "requested_ref": {
          "title": "Requested Ref",
          "type": "string"
        },
        "requested_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requested Commit"
        },
        "commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit"
        },
        "tree": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tree"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        },
        "preparation_seconds": {
          "default": 0,
          "minimum": 0,
          "title": "Preparation Seconds",
          "type": "number"
        },
        "selection_basis": {
          "default": "branch_tip",
          "enum": [
            "branch_tip",
            "user_declared"
          ],
          "title": "Selection Basis",
          "type": "string"
        },
        "profile_revision_match": {
          "const": "unverified",
          "default": "unverified",
          "title": "Profile Revision Match",
          "type": "string"
        }
      },
      "required": [
        "status",
        "repository",
        "requested_ref"
      ],
      "title": "SourceSnapshot",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "checkpoint": {
      "additionalProperties": true,
      "title": "Checkpoint",
      "type": "object"
    },
    "message": {
      "default": "Analysis step completed.",
      "title": "Message",
      "type": "string"
    },
    "report": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProfileAnalysis"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "context_update": {
      "anyOf": [
        {
          "$ref": "#/$defs/ContextUpdateProposal"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "title": "AnalysisStep",
  "type": "object"
}