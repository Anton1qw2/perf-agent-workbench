# demo works without model calls. Use llm for real agents.
PERF_CHAT_MODE=demo
# demo: existing integration scenario; profile-demo: synthetic profile; profile-mcp: real MCP
PERF_CHAT_EXECUTOR=demo
PROFILER_MCP_URL=
PROFILER_MCP_TIMEOUT_SECONDS=60
# Backend registration only. Use JSON with forward-slash Windows paths or escaped backslashes.
PERF_CHAT_GIT_REPOSITORIES={}
PERF_CHAT_MODEL_INPUT_BYTES=120000
PERF_CHAT_DB=data/perf-chat.sqlite3
# API listener. Keep loopback for local use.
PERF_CHAT_API_HOST=127.0.0.1
PERF_CHAT_API_PORT=8000
# TUI connection URL; update when changing the listener port or host.
PERF_CHAT_API_URL=http://127.0.0.1:8000
# Set these for PERF_CHAT_MODE=llm. BASE_URL must include /v1 if required by your provider.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=90

# Non-Windows token storage: install .[secrets] and configure a persistent Fernet key.
# PERF_CHAT_SECRET_KEY=
